rules_version = '2';

// 토브 파트너스 사이트 데이터 규칙
// - inquiries : 방문자는 '새 신청 쓰기'만, 읽기 · 삭제는 관리자만
// - daily, pageviews : 방문 집계. 방문자는 숫자를 1씩 올리기만, 읽기는 관리자만
// - 관리자는 Firebase Authentication 의 관리자 계정 UID 로만 확인한다
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'aN3sL1lEJEMA2r4ZCQ4JskL3uXy1';
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isDay(d) {
      return d is string && d.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }

    match /inquiries/{id} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['company', 'name', 'phone', 'agree', 'createdAt'])
        && request.resource.data.keys().hasAll(['company', 'name', 'phone', 'agree', 'createdAt'])
        && str(request.resource.data.company, 1, 100)
        && str(request.resource.data.name, 1, 50)
        && str(request.resource.data.phone, 9, 30)
        && request.resource.data.phone.matches('^[0-9+() .-]{9,30}$')
        && request.resource.data.agree == true
        && request.resource.data.createdAt == request.time;
    }

    match /daily/{day} {
      allow read: if isAdmin();
      allow delete: if false;
      allow create: if isDay(day)
        && request.resource.data.keys().hasOnly(['date', 'views', 'visitors'])
        && request.resource.data.date == day
        && request.resource.data.views == 1
        && request.resource.data.visitors in [0, 1];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'visitors'])
        && request.resource.data.views == resource.data.views + 1
        && request.resource.data.visitors in [resource.data.visitors, resource.data.visitors + 1];
    }

    match /pageviews/{id} {
      allow read: if isAdmin();
      allow delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['date', 'page', 'n'])
        && isDay(request.resource.data.date)
        && request.resource.data.page is string
        && request.resource.data.page.matches('^[a-z0-9-]{1,60}$')
        && id == request.resource.data.date + '_' + request.resource.data.page
        && request.resource.data.n == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }
  }
}
